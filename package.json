{
  "name": "agent-collab-platform",
  "version": "1.0.0",
  "description": "Multi-Agent 联调测试基建系统 - Socket.io 聊天室",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "install:all": "pnpm install",
    "dev:server": "pnpm -F agent-collab-server dev",
    "dev:frontend": "pnpm -F agent-collab-frontend dev",
    "start:worker": "pnpm -F agent-collab-worker start",
    "build:frontend": "pnpm -F agent-collab-frontend build",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d"
  },
  "dependencies": {
    "socket.io-client": "^4.7.4"
  }
}
